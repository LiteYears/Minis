#!/bin/sh
# /usr/local/bin/minis-serve — Start, manage, hot-reload, and auto-preview live
# local web servers ("Interactive Micro-App Canvas") inside the Minis Alpine sandbox.
#
# Runs servers detached via setsid with stdin/stdout/stderr redirected to
# /tmp/minis-server-<port>.log so shell_execute returns immediately once the
# port is listening, while PRoot stays attached to the background server.
# Emits OSC 1337 MinisSandboxServer + MinisOpenURL markers so the Android host
# automatically registers the live port and opens the Interactive Micro-App Canvas.

usage() {
    cat <<'EOF'
Usage:
  minis-serve [start] [--watch] --port <port> [--title "<title>"] [--workdir <dir>] [--path </subpath>] [--] <command...>
  minis-serve [--watch] <port> <command...>
  minis-serve static <port> [dir] [--title "<title>"]
  minis-serve db <file.sqlite|file.csv|file.tsv|file.json|file.jsonl> [--port <port>] [--title "<title>"]
  minis-serve restart <port>
  minis-serve open <port> [--path </subpath>] [--title "<title>"]
  minis-serve list
  minis-serve logs <port> [lines]
  minis-serve stop [<port>|--all]

Examples:
  minis-serve 8000 python3 app.py
  minis-serve --watch 8000 python3 app.py
  minis-serve static 8080 /var/minis/workspace/dist
  minis-serve db /var/minis/workspace/analytics.sqlite
  minis-serve db /var/minis/workspace/sales.csv --port 8125 --title "Sales Explorer"
  minis-serve --port 8080 --title "SQLite Dashboard" --workdir /var/minis/workspace -- python3 server.py
  minis-serve 5000 flask --app dashboard.py run --host 127.0.0.1 --port 5000
  minis-serve restart 8000
  minis-serve logs 8000
  minis-serve stop 8000
EOF
}

is_port_listening() {
    _p="$1"
    # Convert decimal port to 4-digit uppercase hex for /proc/net/tcp & tcp6
    _hex=$(printf "%04X" "$_p" 2>/dev/null)
    if [ -n "$_hex" ]; then
        if awk -v h=":$_hex" '$4 == "0A" && index(toupper($2), h) > 0 { found=1; exit 0 } END { exit !found }' /proc/net/tcp /proc/net/tcp6 2>/dev/null; then
            return 0
        fi
    fi
    if command -v nc >/dev/null 2>&1; then
        nc -z -w 1 127.0.0.1 "$_p" >/dev/null 2>&1 && return 0
    fi
    return 1
}

find_free_port() {
    _cand="${1:-8123}"
    while is_port_listening "$_cand"; do
        _cand=$((_cand + 1))
    done
    echo "$_cand"
}

json_escape() {
    printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e ':a;N;$!ba;s/\n/ /g'
}

json_extract() {
    # Extract a string field from simple single-line JSON: json_extract "$file" "key"
    _file="$1"
    _key="$2"
    sed -n 's/.*"'"$_key"'"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$_file" 2>/dev/null | head -n 1
}

stop_port() {
    _p="$1"
    _keep_meta="${2:-1}"
    _pidfile="/tmp/minis-server-${_p}.pid"
    if [ -f "$_pidfile" ]; then
        _oldpid=$(cat "$_pidfile" 2>/dev/null)
        if [ -n "$_oldpid" ]; then
            kill -TERM "-$_oldpid" 2>/dev/null || kill -TERM "$_oldpid" 2>/dev/null
            sleep 0.2
            kill -KILL "-$_oldpid" 2>/dev/null || kill -KILL "$_oldpid" 2>/dev/null
        fi
        rm -f "$_pidfile"
    fi
    if [ "$_keep_meta" = "0" ]; then
        rm -f "/tmp/minis-server-${_p}.json"
    fi
    if command -v fuser >/dev/null 2>&1; then
        fuser -k "${_p}/tcp" >/dev/null 2>&1
    fi
}

if [ $# -eq 0 ]; then
    usage >&2
    exit 1
fi

SUBCMD="$1"
case "$SUBCMD" in
    -h|--help|help)
        usage
        exit 0
        ;;
    list|status)
        found=0
        for jf in /tmp/minis-server-*.json; do
            [ -f "$jf" ] || continue
            port=$(printf '%s' "$jf" | sed -e 's|^/tmp/minis-server-||' -e 's|\.json$||')
            pidfile="/tmp/minis-server-${port}.pid"
            pid=""
            [ -f "$pidfile" ] && pid=$(cat "$pidfile" 2>/dev/null)
            if is_port_listening "$port"; then
                state="LIVE"
            elif [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
                state="STARTING"
            else
                state="STOPPED"
            fi
            printf "port=%s state=%s pid=%s meta=%s\n" "$port" "$state" "${pid:-none}" "$(cat "$jf" 2>/dev/null)"
            found=1
        done
        if [ "$found" -eq 0 ]; then
            echo "No sandbox servers registered via minis-serve."
        fi
        exit 0
        ;;
    logs)
        shift
        port="$1"
        lines="${2:-60}"
        if [ -z "$port" ]; then
            echo "Usage: minis-serve logs <port> [lines]" >&2
            exit 1
        fi
        logfile="/tmp/minis-server-${port}.log"
        if [ ! -f "$logfile" ]; then
            echo "No log file found at $logfile" >&2
            exit 1
        fi
        tail -n "$lines" "$logfile"
        exit 0
        ;;
    stop)
        shift
        target="$1"
        if [ "$target" = "--all" ] || [ -z "$target" ]; then
            for jf in /tmp/minis-server-*.json /tmp/minis-server-*.pid; do
                [ -f "$jf" ] || continue
                p=$(printf '%s' "$jf" | sed -e 's|^/tmp/minis-server-||' -e 's|\.\(pid\|json\)$||')
                stop_port "$p" 1
                printf '\033]1337;MinisSandboxServer={"action":"stop","port":%s}\007' "$p"
                echo "[minis-serve] Stopped server on port $p"
            done
        else
            stop_port "$target" 1
            printf '\033]1337;MinisSandboxServer={"action":"stop","port":%s}\007' "$target"
            echo "[minis-serve] Stopped server on port $target"
        fi
        exit 0
        ;;
    restart)
        shift
        port="$1"
        if [ -z "$port" ]; then
            echo "Usage: minis-serve restart <port>" >&2
            exit 1
        fi
        metafile="/tmp/minis-server-${port}.json"
        if [ ! -f "$metafile" ]; then
            echo "[minis-serve] No saved metadata for port $port; starting static server in /var/minis/workspace..."
            exec "$0" static "$port" /var/minis/workspace
        fi
        saved_title=$(json_extract "$metafile" "title")
        saved_workdir=$(json_extract "$metafile" "workdir")
        saved_cmd=$(json_extract "$metafile" "cmd")
        [ -z "$saved_workdir" ] && saved_workdir="/var/minis/workspace"
        [ -z "$saved_cmd" ] && saved_cmd="python3 -m http.server $port --bind 127.0.0.1"
        exec "$0" start --port "$port" --title "${saved_title:-Sandbox App (:$port)}" --workdir "$saved_workdir" -- /bin/sh -c "$saved_cmd"
        ;;
    static)
        shift
        port="$1"
        if [ -z "$port" ]; then
            echo "Usage: minis-serve static <port> [dir] [--title \"<title>\"]" >&2
            exit 1
        fi
        shift
        dir=""
        title=""
        while [ $# -gt 0 ]; do
            case "$1" in
                -t|--title|--name) title="$2"; shift 2 ;;
                -w|--workdir|--dir) dir="$2"; shift 2 ;;
                *)
                    if [ -z "$dir" ]; then
                        dir="$1"
                    fi
                    shift
                    ;;
            esac
        done
        if [ -z "$dir" ]; then
            if [ -d "/var/minis/workspace" ] && [ "$PWD" = "/root" ]; then
                dir="/var/minis/workspace"
            else
                dir="$PWD"
            fi
        fi
        [ -z "$title" ] && title="Static Web Server (:${port})"
        exec "$0" start --port "$port" --title "$title" --workdir "$dir" -- python3 -m http.server "$port" --bind 127.0.0.1
        ;;
    db|data|sqlite|csv)
        shift
        db_port=""
        db_file=""
        db_title=""
        while [ $# -gt 0 ]; do
            case "$1" in
                -p|--port) db_port="$2"; shift 2 ;;
                -t|--title|--name) db_title="$2"; shift 2 ;;
                ''|*[!0-9]*)
                    if [ -z "$db_file" ]; then
                        db_file="$1"
                    fi
                    shift
                    ;;
                *)
                    if [ -z "$db_port" ]; then
                        db_port="$1"
                    elif [ -z "$db_file" ]; then
                        db_file="$1"
                    fi
                    shift
                    ;;
            esac
        done
        if [ -z "$db_file" ]; then
            echo "Usage: minis-serve db <file.sqlite|file.csv|file.tsv|file.json|file.jsonl> [--port <port>] [--title \"<title>\"]" >&2
            exit 1
        fi
        case "$db_file" in
            /*) ;;
            *) db_file="$PWD/$db_file" ;;
        esac
        if [ ! -e "$db_file" ]; then
            echo "Error: Data file not found: $db_file" >&2
            exit 1
        fi
        [ -z "$db_port" ] && db_port=$(find_free_port 8123)
        [ -z "$db_title" ] && db_title="Data Studio · $(basename "$db_file")"
        db_workdir=$(dirname "$db_file")
        exec "$0" start --port "$db_port" --title "$db_title" --workdir "$db_workdir" -- \
            python3 /usr/local/lib/minis-data-studio/server.py --file "$db_file" --port "$db_port" --title "$db_title"
        ;;
    open)
        shift
        port="$1"
        shift 2>/dev/null || true
        subpath="/"
        title=""
        while [ $# -gt 0 ]; do
            case "$1" in
                --path) subpath="$2"; shift 2 ;;
                --title) title="$2"; shift 2 ;;
                *) shift ;;
            esac
        done
        case "$subpath" in
            /*) ;;
            *) subpath="/$subpath" ;;
        esac
        url="http://127.0.0.1:${port}${subpath}"
        esc_title=$(json_escape "$title")
        printf '\033]1337;MinisSandboxServer={"action":"open","port":%s,"url":"%s","title":"%s"}\007' "$port" "$url" "$esc_title"
        printf '\033]1337;MinisOpenURL=%s\007' "$url"
        echo "[minis-serve] Opened live preview: $url"
        exit 0
        ;;
    start)
        shift
        ;;
esac

PORT=""
TITLE=""
WORKDIR=""
SUBPATH="/"
WAIT_SECS=15
WATCH_MODE=0

while [ $# -gt 0 ]; do
    case "$1" in
        --watch)
            WATCH_MODE=1
            shift
            ;;
        -p|--port)
            PORT="$2"
            shift 2
            ;;
        -t|--title|--name)
            TITLE="$2"
            shift 2
            ;;
        -w|--workdir|--cwd|--dir)
            WORKDIR="$2"
            shift 2
            ;;
        --path)
            SUBPATH="$2"
            shift 2
            ;;
        --wait)
            WAIT_SECS="$2"
            shift 2
            ;;
        --)
            shift
            break
            ;;
        ''|*[!0-9]*)
            break
            ;;
        *)
            if [ -z "$PORT" ]; then
                PORT="$1"
                shift
            else
                break
            fi
            ;;
    esac
done

if [ -z "$PORT" ]; then
    usage >&2
    exit 1
fi

# If no command was supplied (or a directory or data file was supplied), serve automatically!
if [ $# -eq 0 ]; then
    set -- python3 -m http.server "$PORT" --bind 127.0.0.1
elif [ $# -eq 1 ] && [ -f "$1" ]; then
    case "$1" in
        *.db|*.sqlite|*.sqlite3|*.csv|*.tsv|*.jsonl)
            _abs_df="$1"
            case "$_abs_df" in
                /*) ;;
                *) _abs_df="$PWD/$_abs_df" ;;
            esac
            [ -z "$TITLE" ] && TITLE="Data Studio · $(basename "$_abs_df")"
            set -- python3 /usr/local/lib/minis-data-studio/server.py --file "$_abs_df" --port "$PORT" --title "$TITLE"
            ;;
    esac
elif [ $# -eq 1 ] && [ -d "$1" ]; then
    WORKDIR="$1"
    set -- python3 -m http.server "$PORT" --bind 127.0.0.1
fi

if [ -z "$WORKDIR" ]; then
    if [ -d "/var/minis/workspace" ] && [ "$PWD" = "/root" ]; then
        WORKDIR="/var/minis/workspace"
    else
        WORKDIR="$PWD"
    fi
fi

case "$SUBPATH" in
    /*) ;;
    *) SUBPATH="/$SUBPATH" ;;
esac

if [ -z "$TITLE" ]; then
    TITLE="Sandbox App (:${PORT})"
fi

# Stop any prior server on this port
stop_port "$PORT" 1

LOGFILE="/tmp/minis-server-${PORT}.log"
PIDFILE="/tmp/minis-server-${PORT}.pid"
METAFILE="/tmp/minis-server-${PORT}.json"
: > "$LOGFILE"

CMD_STR="$*"

if [ ! -d "$WORKDIR" ]; then
    mkdir -p "$WORKDIR" 2>/dev/null || WORKDIR="/tmp"
fi

if [ "$WATCH_MODE" -eq 1 ]; then
    # Launch with lightweight auto-reload file watcher inside its own session
    setsid /bin/sh -c '
        cd "$1" || exit 1
        shift
        echo "$$" > "'"$PIDFILE"'"
        calc_sig() {
            find . -maxdepth 3 \( -name "*.py" -o -name "*.js" -o -name "*.ts" -o -name "*.html" -o -name "*.css" -o -name "*.json" -o -name "*.go" \) -exec stat -c "%Y:%n" {} + 2>/dev/null | sort | md5sum 2>/dev/null
        }
        LAST_SIG=$(calc_sig)
        while true; do
            if [ $# -eq 1 ]; then
                /bin/sh -c "$1" &
            else
                "$@" &
            fi
            CHILD_PID=$!
            trap "kill -TERM $CHILD_PID 2>/dev/null; exit 0" TERM INT
            while kill -0 "$CHILD_PID" 2>/dev/null; do
                sleep 1.5
                NEW_SIG=$(calc_sig)
                if [ -n "$NEW_SIG" ] && [ "$NEW_SIG" != "$LAST_SIG" ]; then
                    echo "[minis-serve --watch] File change detected; restarting server..."
                    LAST_SIG="$NEW_SIG"
                    kill -TERM "$CHILD_PID" 2>/dev/null
                    sleep 0.3
                    kill -KILL "$CHILD_PID" 2>/dev/null
                    break
                fi
            done
            sleep 0.2
        done
    ' sh "$WORKDIR" "$@" </dev/null >>"$LOGFILE" 2>&1 &
else
    # Launch in its own session (setsid) with fds 0/1/2 detached from the command pipe
    setsid /bin/sh -c '
        cd "$1" || exit 1
        shift
        echo "$$" > "'"$PIDFILE"'"
        if [ $# -eq 1 ]; then
            exec /bin/sh -c "$1"
        else
            exec "$@"
        fi
    ' sh "$WORKDIR" "$@" </dev/null >>"$LOGFILE" 2>&1 &
fi

sleep 0.15
SERVER_PID=""
[ -f "$PIDFILE" ] && SERVER_PID=$(cat "$PIDFILE" 2>/dev/null)

ESC_TITLE=$(json_escape "$TITLE")
ESC_CMD=$(json_escape "$CMD_STR")
ESC_WORKDIR=$(json_escape "$WORKDIR")
URL="http://127.0.0.1:${PORT}${SUBPATH}"

cat > "$METAFILE" <<EOF
{"port":${PORT},"url":"${URL}","title":"${ESC_TITLE}","pid":${SERVER_PID:-0},"workdir":"${ESC_WORKDIR}","cmd":"${ESC_CMD}"}
EOF

# Wait for the server to bind and accept connections on 127.0.0.1:<PORT>
MAX_TICKS=$((WAIT_SECS * 5))
i=0
while [ "$i" -lt "$MAX_TICKS" ]; do
    if is_port_listening "$PORT"; then
        printf '\033]1337;MinisSandboxServer={"action":"start","port":%s,"url":"%s","title":"%s","pid":%s,"workdir":"%s","cmd":"%s"}\007' \
            "$PORT" "$URL" "$ESC_TITLE" "${SERVER_PID:-0}" "$ESC_WORKDIR" "$ESC_CMD"
        printf '\033]1337;MinisOpenURL=%s\007' "$URL"
        echo "[minis-serve] Live server ready at $URL (PID ${SERVER_PID:-unknown}, workdir: $WORKDIR, logs: $LOGFILE)"
        exit 0
    fi
    if [ -n "$SERVER_PID" ] && ! kill -0 "$SERVER_PID" 2>/dev/null; then
        echo "[minis-serve] Server process (PID $SERVER_PID) exited before binding port $PORT. Log output:" >&2
        cat "$LOGFILE" >&2
        exit 1
    fi
    sleep 0.2
    i=$((i + 1))
done

# Even if it hasn't finished binding after WAIT_SECS (e.g. heavy framework boot),
# if the process is still alive, register it and open the preview (WebViewHolder
# will auto-retry while it finishes warming up).
if [ -n "$SERVER_PID" ] && kill -0 "$SERVER_PID" 2>/dev/null; then
    printf '\033]1337;MinisSandboxServer={"action":"start","port":%s,"url":"%s","title":"%s","pid":%s,"workdir":"%s","cmd":"%s"}\007' \
        "$PORT" "$URL" "$ESC_TITLE" "${SERVER_PID:-0}" "$ESC_WORKDIR" "$ESC_CMD"
    printf '\033]1337;MinisOpenURL=%s\007' "$URL"
    echo "[minis-serve] Server starting on $URL (PID $SERVER_PID still warming up, logs: $LOGFILE)"
    exit 0
fi

echo "[minis-serve] Timed out waiting for port $PORT. Log output:" >&2
cat "$LOGFILE" >&2
exit 1
